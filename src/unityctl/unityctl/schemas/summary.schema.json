{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk.example/schemas/unity-agent-bridge/summary.schema.json",
  "title": "Unity Agent Bridge Session Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "hasProblems",
    "hasBlockingProblems",
    "logCount",
    "warningCount",
    "errorCount",
    "exceptionCount",
    "assertCount",
    "ignoredProblemCount",
    "blockingProblemCount",
    "lastProblem",
    "startedAt",
    "endedAt",
    "durationMs",
    "failedReason"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["passed", "problem_detected", "failed"]
    },
    "hasProblems": {
      "type": "boolean"
    },
    "hasBlockingProblems": {
      "type": "boolean"
    },
    "logCount": {
      "type": "integer",
      "minimum": 0
    },
    "warningCount": {
      "type": "integer",
      "minimum": 0
    },
    "errorCount": {
      "type": "integer",
      "minimum": 0
    },
    "exceptionCount": {
      "type": "integer",
      "minimum": 0
    },
    "assertCount": {
      "type": "integer",
      "minimum": 0
    },
    "ignoredProblemCount": {
      "type": "integer",
      "minimum": 0
    },
    "blockingProblemCount": {
      "type": "integer",
      "minimum": 0
    },
    "lastProblem": {
      "anyOf": [
        {
          "$ref": "#/$defs/problem"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "type": ["string", "null"]
    },
    "endedAt": {
      "type": ["string", "null"]
    },
    "durationMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "failedReason": {
      "type": ["string", "null"],
      "description": "当 session.json 的 status 为 failed（进程级失败，如编译失败/超时/Editor 退出）时的原因。"
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message",
        "severity",
        "sequence",
        "playModeFrame",
        "scenePath"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Error", "Exception", "Assert"]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["problem", "blocking"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "playModeFrame": {
          "type": "integer",
          "minimum": -1
        },
        "scenePath": {
          "type": "string"
        }
      }
    }
  }
}
