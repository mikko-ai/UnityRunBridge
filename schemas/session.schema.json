{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elex.example/schemas/unity-agent-bridge/session.schema.json",
  "title": "Unity Agent Bridge Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "name",
    "projectPath",
    "scenePath",
    "createdAt",
    "startedAt",
    "endedAt",
    "status",
    "trigger",
    "task"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "projectPath": {
      "type": "string",
      "minLength": 1
    },
    "scenePath": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "startedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/utcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "endedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/utcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["created", "running", "stopped"]
    },
    "trigger": {
      "type": "string",
      "enum": ["agent", "human", "script"]
    },
    "task": {
      "type": "string"
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
