{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mk.example/schemas/unity-agent-bridge/summary.schema.json",
  "title": "Unity Agent Bridge Session Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "hasProblems",
    "hasBlockingProblems",
    "logCount",
    "warningCount",
    "errorCount",
    "exceptionCount",
    "assertCount",
    "ignoredProblemCount",
    "blockingProblemCount",
    "lastProblem",
    "watchedCount",
    "watchedLogs",
    "startedAt",
    "endedAt",
    "durationMs",
    "failedReason"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["passed", "problem_detected", "failed"]
    },
    "hasProblems": {
      "type": "boolean"
    },
    "hasBlockingProblems": {
      "type": "boolean"
    },
    "logCount": {
      "type": "integer",
      "minimum": 0
    },
    "warningCount": {
      "type": "integer",
      "minimum": 0
    },
    "errorCount": {
      "type": "integer",
      "minimum": 0
    },
    "exceptionCount": {
      "type": "integer",
      "minimum": 0
    },
    "assertCount": {
      "type": "integer",
      "minimum": 0
    },
    "ignoredProblemCount": {
      "type": "integer",
      "minimum": 0
    },
    "blockingProblemCount": {
      "type": "integer",
      "minimum": 0
    },
    "lastProblem": {
      "anyOf": [
        {
          "$ref": "#/$defs/problem"
        },
        {
          "type": "null"
        }
      ]
    },
    "watchedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "命中 log-rules.json watch 规则的日志总数。"
    },
    "watchedLogs": {
      "type": "array",
      "maxItems": 50,
      "description": "命中 watch 规则的日志（最多保留最近 50 条；line 为该条日志在 unity-console.jsonl 中的 1-based 行号）。",
      "items": {
        "$ref": "#/$defs/watchedLog"
      }
    },
    "startedAt": {
      "type": ["string", "null"]
    },
    "endedAt": {
      "type": ["string", "null"]
    },
    "durationMs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "failedReason": {
      "type": ["string", "null"],
      "description": "当 session.json 的 status 为 failed（进程级失败，如编译失败/超时/Editor 退出）时的原因。"
    },
    "scenario": {
      "description": "仅当该 session 由 `unityctl scenario run` 产生时存在；断言失败视为 blocking，与 Exception 同级。",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stepsTotal", "stepsPassed", "stepsFailed", "assertions"],
      "properties": {
        "name": {
          "type": "string"
        },
        "stepsTotal": {
          "type": "integer",
          "minimum": 0
        },
        "stepsPassed": {
          "type": "integer",
          "minimum": 0
        },
        "stepsFailed": {
          "type": "integer",
          "minimum": 0
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "expected", "actual", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
              "expected": {},
              "actual": {},
              "evidence": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "metrics": {
      "description": "仅当该 session 的 artifacts/metrics.jsonl 存在（即执行过 profile-start/profile-stop）时存在；按指标名聚合 avg/max/p95。绝对值含 Editor 开销，不代表真机性能，只用于同机同项目改动前后的相对回归比较。",
      "type": "object",
      "additionalProperties": false,
      "required": ["frameCount", "metrics"],
      "properties": {
        "frameCount": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["avg", "max", "p95"],
            "properties": {
              "avg": { "type": "number" },
              "max": { "type": "number" },
              "p95": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message",
        "severity",
        "sequence",
        "playModeFrame",
        "scenePath"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Error", "Exception", "Assert"]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["problem", "blocking"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "playModeFrame": {
          "type": "integer",
          "minimum": -1
        },
        "scenePath": {
          "type": "string"
        }
      }
    },
    "watchedLog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "type",
        "message",
        "sequence",
        "playModeFrame",
        "scenePath"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": ["Log", "Warning", "Error", "Exception", "Assert"]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "playModeFrame": {
          "type": "integer",
          "minimum": -1
        },
        "scenePath": {
          "type": "string"
        }
      }
    }
  }
}
